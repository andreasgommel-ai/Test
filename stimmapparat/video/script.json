   "lines": [
    {
     "text": "Wie entsteht eigentlich unsere Stimme?"
    },
    {
     "text": "In diesem Video verfolgen wir den Weg der Luft: von der Lunge über den Kehlkopf bis zu den Lippen."
    },
    {
     "text": "Vier Systeme arbeiten dabei zusammen.",
     "cues": [
      [
       "0",
       "chain",
       0
      ]
     ]
    },
    {
     "text": "Die Atmung liefert die Energie.",
     "cues": [
      [
       "0",
       "chain",
       1
      ]
     ]
    },
    {
     "text": "Die Stimmlippen erzeugen den Ton.",
     "cues": [
      [
       "0",
       "chain",
       2
      ]
     ]
    },
    {
     "text": "Das Ansatzrohr formt den Klang.",
     "cues": [
      [
       "0",
       "chain",
       3
      ]
     ]
    },
    {
     "text": "Und die Artikulationsorgane machen daraus Sprache.",
     "cues": [
      [
       "0",
       "chain",
       4
      ]
     ]
    }
   ]
