      [
       "0",
       "hi",
       null
      ],
      [
       "0",
       "mode",
       "rest"
      ]
     ]
    },
    {
     "text": "Beim Sprechen ändert sich das Muster: Wir atmen kurz durch den Mund ein und dann lange und kontrolliert wieder aus.",
